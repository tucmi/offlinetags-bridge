/* PiPL: the resource a Photoshop-compatible host reads to list the filter in its menu.
 *
 * Normally generated by Adobe's tools; written out here so the build needs
 * only rc.exe. Layout: 16-bit signature, 32-bit version, 32-bit property count,
 * then per property: vendor, key, id, data length, data padded to 4 bytes.
 * Four-character codes are stored reversed on Windows. Strings are raw bytes,
 * rc adds no terminator. tests/test_affinity_plugin.py parses the built resource.
 */
1 PiPL DISCARDABLE
BEGIN
    0x0001, 0L, 8L,

    /* kind: filter */
    "MIB8", "dnik", 0L, 4L, "MFB8",

    /* name: Pascal string, 7 characters */
    "MIB8", "eman", 0L, 8L, "\007Analyze",

    /* catg: menu category, Pascal string, 11 characters */
    "MIB8", "gtac", 0L, 12L, "\013OfflineTags",

    /* vers: filter interface 4.0 */
    "MIB8", "srev", 0L, 4L, 0x00040000L,

    /* 8664: name of the 64-bit entry point */
    "MIB8", "4668", 0L, 12L, "PluginMain\0\0",

    /* mode: RGB (first byte, 0x10) and 16-bit RGB (second byte, 0x10) */
    "MIB8", "edom", 0L, 2L, 0x1010, 0x0000,

    /* enbl: when the menu entry is enabled. Affinity reads the supported
       formats from this expression and hides filters that lack it. */
    "MIB8", "lbne", 0L, 44L, "in (PSHOP_ImageMode, RGBMode, RGB48Mode)\0\0\0\0",

    /* fici: for each of the 7 filter cases: plain input, plain output, no flags */
    "MIB8", "icif", 0L, 28L,
    0x00000101L, 0x00000101L, 0x00000101L, 0x00000101L, 0x00000101L, 0x00000101L, 0x00000101L
END
